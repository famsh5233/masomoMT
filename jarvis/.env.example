# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=
JARVIS_TUTOR_MODEL=claude-haiku-4-5
JARVIS_OFFICE_MODEL=claude-sonnet-5
JARVIS_DB=/data/jarvis.db
JARVIS_CONTENT_DIR=/data/content
JARVIS_FREE_TURNS=10
JARVIS_PAID_TURNS=40
JARVIS_ADMIN_KEY=change-me-long-random
# prod (default) | dev. dev enables the demo tutor and shows login codes in API responses.
JARVIS_ENV=prod
# Only needed if a web version of the app is hosted on another domain.
JARVIS_CORS_ORIGINS=

# Login codes by SMS (Africa's Talking). Use username "sandbox" with a sandbox API key to test.
JARVIS_SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Country calling codes allowed to receive codes (protects against SMS fraud).
JARVIS_OTP_COUNTRIES=255,254,256

# Existing Masomo video lessons
JARVIS_LEGACY_VIDEOS_URL=https://masomo.co.tz/api/week_videos?week={week}

# AzamPay (sandbox first; production URLs come with your merchant account)
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_URL=https://sandbox.azampay.co.tz
# Register the callback as https://api.masomo.co.tz/v1/pay/azampay/callback?key=<this value>
AZAMPAY_CALLBACK_SECRET=change-me-long-random

# Google Play
PLAY_PACKAGE_NAME=tz.co.masomo.app
PLAY_SERVICE_ACCOUNT_FILE=/data/play-service-account.json
